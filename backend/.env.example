# AlgoViz AI Backend Configuration Example
# Copy this file to .env (do NOT commit .env with real credentials)

# Your API Key (e.g. from Groq, Grok, OpenAI, or Google AI Studio)
AI_API_KEY=YOUR_API_KEY_HERE

# Model Name (e.g. llama-3.3-70b-versatile, gemini-1.5-flash, gpt-4o-mini)
AI_MODEL=llama-3.3-70b-versatile

# Base URL (OpenAI-compatible endpoint)
AI_BASE_URL=https://api.groq.com/openai/v1/

# Server Port
PORT=3001

# CORS Allowed Origins (comma-separated, leave blank for local dev)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication Security
# Set to 'production' to disable all dev inspection and enforce strict HTTPS/cookies
NODE_ENV=development
DEBUG_AUTH=false

# Optional MongoDB Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net
MONGODB_DB_NAME=algoviz
