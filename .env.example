# AlgoViz AI Backend Configuration
# Compatible with Gemini, OpenAI, Groq, Ollama, DeepSeek, or any OpenAI-compatible API

# Your API Key (e.g. from Google AI Studio or OpenAI)
AI_API_KEY=YOUR_API_KEY_HERE

# Model Name (e.g. gemini-1.5-flash, gpt-4o-mini, deepseek-chat, llama-3.1-70b)
AI_MODEL=gemini-1.5-flash

# Base URL (defaults to Gemini OpenAI-compatible endpoint)
# For Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# For OpenAI: https://api.openai.com/v1/
# For Groq: https://api.groq.com/openai/v1/
# For Ollama: http://localhost:11434/v1/
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Server Port (for node server.js)
PORT=3001
